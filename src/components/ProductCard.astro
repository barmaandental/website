---
import { productWhatsApp } from '../data/site';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  slug: string;
  image?: any;
  imageName?: string;
  category?: string;
}
const { title, slug, image, imageName, category } = Astro.props;

const alt = imageName
  ? `${title} – ${category || 'dental'} product available from Barmaan Dental South Africa`
  : `${title} – Barmaan Dental product`;

const href = `/product/${slug}/`;

let src;
if (image) {
  try {
    src = (await getImage({ src: image, width: 500, format: 'webp' })).src;
  } catch {
    src = image.src ?? image;
  }
}
---

<article class="product-card">
  <a href={href} class="card-link" aria-label={`View ${title} product details`}>
    <div class="card-img">
      {src ? (
        <img src={src} alt={alt} width="500" height="500" loading="lazy" />
      ) : (
        <div class="img-placeholder" role="img" aria-label={alt}>{title.slice(0, 1)}</div>
      )}
    </div>
    <h3>{title}</h3>
  </a>
  <a
    href={productWhatsApp(title)}
    target="_blank"
    rel="noopener nofollow"
    class="btn btn-green wa-btn"
  >
    <svg width="17" height="17" viewBox="0 0 32 32" fill="white" aria-hidden="true"><path d="M16 2.7C8.7 2.7 2.7 8.6 2.7 16c0 2.3.6 4.6 1.8 6.6L2.6 29.4l7-1.8c1.9 1.1 4.1 1.6 6.4 1.6 7.3 0 13.3-6 13.3-13.3S23.3 2.7 16 2.7zm0 24.3c-2 0-4-.5-5.7-1.6l-.4-.2-4.1 1.1 1.1-4-.3-.4c-1.1-1.8-1.7-3.8-1.7-5.9 0-6.1 5-11.1 11.1-11.1S27.1 9.9 27.1 16s-5 11-11.1 11zm6.1-8.3c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6-.1-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.3 3.4c.2.2 2.4 3.7 5.8 5.2.8.4 1.4.6 1.9.7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
    WhatsApp for Price
  </a>
</article>

<style>
  .product-card {
    background: var(--white);
    border-radius: 14px;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 26px rgba(13,110,166,.13);
  }
  .card-link { display: block; }
  .card-img {
    aspect-ratio: 1; background: #f7fafc;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .card-img img { width: 100%; height: 100%; object-fit: contain; }
  .img-placeholder {
    font-size: 3rem; font-weight: 700; color: #b9d9ec;
  }
  .product-card h3 {
    font-size: 0.95rem; text-align: center; color: var(--blue);
    padding: 14px 12px 10px; font-weight: 600; line-height: 1.4;
  }
  .wa-btn {
    margin: 0 12px 16px; justify-content: center; font-size: 0.85rem;
    padding: 10px 14px;
  }
</style>
