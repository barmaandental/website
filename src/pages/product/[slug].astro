---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProduct, relatedProducts } from '../../data/catalog';
import { seoTitle, seoDescription, productWhatsApp, site } from '../../data/site';

export async function getStaticPaths() {
  const { products } = await import('../../data/catalog');
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const related = relatedProducts(product);

const title = seoTitle(product.title);
const description = seoDescription(product.description, product.excerpt || 'Premium Swiss dental product from Barmaan Dental, exclusive South African distributor of Dispotech Switzerland.');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  category: product.categories.join(', '),
  brand: { '@type': 'Brand', name: 'Dispotech Switzerland' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'ZAR',
    url: `${site.domain}/product/${product.slug}/`,
    priceSpecification: {
      '@type': 'PriceSpecification',
      description: 'Price available upon request via WhatsApp or contact form',
    },
  },
};
---

<BaseLayout title={title} description={description} path={`/product/${product.slug}/`} image={product.imageMeta?.src} type="product" jsonLd={jsonLd}>
  <section class="product-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/shop/">Shop</a> <span aria-hidden="true">/</span>
        <span>{product.title}</span>
      </nav>
    </div>
  </section>

  <section class="product-body">
    <div class="container product-grid">
      <div class="p-img">
        {product.imageMeta ? (
          <img
            src={product.imageMeta.src}
            alt={`${product.title} – premium dental product from Barmaan Dental, South African distributor of Dispotech Switzerland`}
            width="700" height="700" loading="eager" fetchpriority="high"
          />
        ) : (
          <div class="img-fallback" aria-hidden="true">{product.title.slice(0, 1)}</div>
        )}
      </div>
      <div class="p-info">
        <h1>{product.title}</h1>
        {product.description && <p class="p-desc">{product.description}</p>}

        <dl class="p-meta">
          {product.packSize && (
            <div><dt>Pack size</dt><dd>{product.packSize}</dd></div>
          )}
          <div><dt>Brand</dt><dd>Dispotech Switzerland</dd></div>
          <div><dt>Price</dt><dd>Please contact us for quotation</dd></div>
        </dl>

        <div class="p-actions">
          <a href={productWhatsApp(product.title)} target="_blank" rel="noopener nofollow" class="btn btn-green">
            WhatsApp for Price
          </a>
          <a href="/contact-us/" class="btn btn-blue">Send an Inquiry</a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related">
      <div class="container">
        <h2>Related products</h2>
        <div class="related-grid">
          {related.map((r) => (
            <ProductCard title={r.title} slug={r.slug} image={r.imageMeta} imageName={r.image} category={r.categories[0]} />
          ))}
        </div>
      </div>
    </section>
  )}

  <style>
    .product-hero { padding: 36px 0 8px; }
    .breadcrumb { font-size: 0.85rem; color: #8a99a6; }
    .breadcrumb a:hover { color: var(--blue); }

    .product-body { padding: 26px 0 50px; }
    .product-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 50px; align-items: start; }
    .p-img {
      background: #f7fafc; border-radius: 18px; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      aspect-ratio: 1;
    }
    .p-img img { width: 100%; height: 100%; object-fit: contain; }
    .img-fallback { font-size: 5rem; color: #b9d9ec; font-weight: 700; }

    .p-info h1 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin-bottom: 18px; }
    .p-desc { font-size: 0.97rem; margin-bottom: 24px; }

    .p-meta { margin-bottom: 28px; border-top: 1px solid #e2edf5; }
    .p-meta > div {
      display: flex; justify-content: space-between; gap: 20px;
      padding: 11px 0; border-bottom: 1px solid #e2edf5; font-size: 0.92rem;
    }
    .p-meta dt { font-weight: 600; color: #55677a; }
    .p-meta dd { text-align: right; }

    .p-actions { display: flex; gap: 14px; flex-wrap: wrap; }

    .related { padding: 20px 0 50px; }
    .related h2 { font-size: 1.5rem; margin-bottom: 24px; }
    .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }

    @media (max-width: 820px) {
      .product-grid { grid-template-columns: 1fr; gap: 30px; }
      .related-grid { grid-template-columns: 1fr; }
    }
    @media (min-width: 560px) and (max-width: 820px) {
      .related-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</BaseLayout>
