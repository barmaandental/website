---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import { seoTitle, seoDescription, site, whatsappLink } from '../data/site';

const title = seoTitle('Contact Us – Product Information, Pricing & Availability');
const description = seoDescription(
  'Contact Barmaan Dental for product information, pricing & availability. WhatsApp, call +27 64 829 9032 or email barmaandental@gmail.com – nationwide delivery across South Africa.',
  'Contact Barmaan Dental – exclusive Dispotech Switzerland distributor in South Africa.'
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Barmaan Dental',
  url: `${site.domain}/contact-us/`,
};
---

<BaseLayout title={title} description={description} path="/contact-us/" jsonLd={jsonLd}>
  <section class="contact-hero">
    <div class="container">
      <p class="badge">● Exclusive South African Distributor</p>
      <h1>Contact Us for Product Information, Pricing &amp; Availability</h1>
      <p class="sub">Direct access to Swiss-engineered Dispotech dental solutions for South African clinics and practitioners.</p>
      <div class="hero-btns">
        <a href={site.phoneLink} class="btn btn-gray">call now</a>
        <a href={whatsappLink('Hello Barmaan Dental!')} target="_blank" rel="noopener" class="btn btn-green">WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="cards-section">
    <div class="container cards-grid">
      <div class="c-card">
        <div class="c-icon" aria-hidden="true">💬</div>
        <h2>WhatsApp</h2>
        <p>Instant support for quick availability checks.</p>
        <a href={whatsappLink('Hello Barmaan Dental!')} target="_blank" rel="noopener" class="c-link">Start chat</a>
      </div>
      <div class="c-card">
        <div class="c-icon" aria-hidden="true">📞</div>
        <h2>Phone</h2>
        <p>Speak directly with our technical specialists.</p>
        <a href={site.phoneLink} class="c-link">{site.phone}</a>
      </div>
      <div class="c-card">
        <div class="c-icon" aria-hidden="true">✉️</div>
        <h2>Email</h2>
        <p>Send us your technical queries or POs.</p>
        <a href={`mailto:${site.email}`} class="c-link">{site.email}</a>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="container">
      <div class="form-card">
        <h2>Send an Inquiry</h2>
        <ContactForm client:visible />
      </div>
    </div>
  </section>

  <section class="coverage">
    <div class="container coverage-grid">
      <div>
        <h2>Nationwide Coverage</h2>
        <p>We supply and service leading dental clinics across South Africa, from Johannesburg to Cape Town. Our logistics network ensures timely delivery of Swiss-precision medical supplies to even the most remote practices.</p>
        <p class="coverage-point">◎ Cape Town Distribution Center</p>
      </div>
      <div class="map-wrap">
        <iframe
          src="https://www.google.com/maps?q=South+Africa&z=5&output=embed"
          width="600" height="400"
          loading="lazy"
          title="Map of South Africa showing Barmaan Dental nationwide delivery coverage"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <style>
    .contact-hero {
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue-deep) 100%);
      color: var(--white); text-align: center; padding: 90px 0 110px;
    }
    .contact-hero h1 { color: var(--white); font-size: clamp(1.9rem, 4vw, 2.7rem); max-width: 850px; margin: 14px auto 16px; }
    .badge { font-weight: 600; font-size: 0.88rem; }
    .sub { font-size: 0.95rem; opacity: .95; margin-bottom: 26px; }
    .hero-btns { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }

    .cards-section { padding: 0 20px; margin-top: -50px; }
    .cards-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
      max-width: 1100px;
    }
    .c-card {
      background: var(--white); border-radius: 16px; padding: 34px 28px;
      text-align: center; box-shadow: 0 8px 26px rgba(13,110,166,.1);
    }
    .c-icon { font-size: 1.9rem; margin-bottom: 10px; }
    .c-card h2 { font-size: 1.4rem; margin-bottom: 8px; }
    .c-card p { font-size: 0.88rem; margin-bottom: 12px; }
    .c-link { color: var(--blue); font-weight: 600; text-decoration: underline; font-size: 0.92rem; }

    .form-section { padding: 50px 0 20px; }
    .form-card {
      max-width: 900px; margin: 0 auto; background: var(--white);
      border: 1px solid #e2edf5; border-radius: 20px; padding: 40px;
      box-shadow: 0 8px 26px rgba(13,110,166,.07);
    }
    .form-card h2 { font-size: 1.5rem; margin-bottom: 24px; }

    .coverage { padding: 60px 0; }
    .coverage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
    .coverage h2 { font-size: 1.6rem; margin-bottom: 14px; }
    .coverage p { font-size: 0.93rem; }
    .coverage-point { margin-top: 16px; font-weight: 600; color: var(--blue-deep); }
    .map-wrap iframe {
      width: 100%; border-radius: 16px; border: 0; aspect-ratio: 4/3; display: block;
    }

    @media (max-width: 820px) {
      .cards-grid { grid-template-columns: 1fr; }
      .coverage-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
